{
  "name": "wellenwerk",
  "productName": "Wellenwerk",
  "version": "1.3.6",
  "description": "Wellenwerk – Stationssteuerung, Logbuch und Digitalbetrieb für Funkamateure",
  "author": {
    "name": "Wellenwerk",
    "email": "wellenwerk@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "de.wellenwerk.app",
    "productName": "Wellenwerk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist/Wellenwerk",
        "to": "server"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../LIZENZEN.md",
        "to": "LIZENZEN.md"
      },
      {
        "from": "../licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Wellenwerk",
      "license": "../LICENSE"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Wellenwerk braucht den Audio-Eingang für Digitalbetrieb und SSTV (Empfang vom Funkgerät)."
      },
      "extraResources": [
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "LICENSE.electron.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "HamRadio",
      "icon": "build/icon.png",
      "maintainer": "Wellenwerk <wellenwerk@users.noreply.github.com>"
    }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "homepage": "https://github.com/djamplifier/wellenwerk",
  "license": "GPL-3.0-or-later"
}
